# Runtime
NODE_ENV=production
PORT=5000
PUBLIC_APP_URL=https://example.com
ALLOWED_PUBLIC_ORIGINS=https://example.com
FRONTEND_BUILD_DIR=../its_prototype/build
UPLOAD_DIR=./uploads

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=replace_with_database_name
DB_USER=replace_with_database_user
DB_PASSWORD=replace_with_rotated_database_password

# Admin authentication and guest order access
# Generate independent random values for each secret below.
JWT_SECRET=replace_with_random_secret_at_least_32_bytes
ORDER_ACCESS_SECRET=replace_with_a_different_random_secret_at_least_32_bytes
ORDER_ACCESS_TOKEN_TTL_HOURS=24
ADMIN_PHONE=replace_with_admin_phone
ADMIN_PASSWORD=replace_with_strong_unique_password

# CDEK
CDEK_BASE_URL=https://api.cdek.ru/v2
CDEK_CLIENT_ID=replace_with_rotated_client_id
CDEK_CLIENT_SECRET=replace_with_rotated_client_secret
CDEK_SERVICE_TOKEN=replace_with_independent_random_service_token
CDEK_CHECKOUT_TARIFF_CODE=136
CDEK_FROM_CITY_CODE=278
CDEK_FROM_COUNTRY_CODE=RU
CDEK_FROM_POSTAL_CODE=660135
# Keep this internal when CDEK is handled by the same Node process.
CDEK_SERVICE_URL=http://127.0.0.1:5000/service.php

# PayKeeper
PAYKEEPER_BASE_URL=https://replace-with-paykeeper-host
PAYKEEPER_LOGIN=replace_with_rotated_login
PAYKEEPER_PASSWORD=replace_with_rotated_password
PAYKEEPER_SECRET_SEED=replace_with_rotated_secret_seed

# Telegram: independent channels with independent bots and recipient lists.
# Chat IDs are comma-separated; *_CHAT_IDS are permanent destinations and are
# automatically included in the matching allowlist.
ENABLE_TELEGRAM_ORDER_CHANNEL=0
ENABLE_TELEGRAM_LOW_STOCK_CHANNEL=0
ENABLE_LOW_STOCK_CRON=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_ORDER_CHAT_IDS=
TELEGRAM_ORDER_ALLOWED_CHAT_IDS=
TELEGRAM_LOW_BOT_TOKEN=
TELEGRAM_LOW_STOCK_CHAT_IDS=
TELEGRAM_LOW_STOCK_ALLOWED_CHAT_IDS=
LOW_STOCK_THRESHOLD=5

# Database and startup diagnostics
ENABLE_SQL_LOGGING=0
ENABLE_DB_ALTER_SYNC=0
ENABLE_STARTUP_WARNINGS=1
TRUST_PROXY=1
