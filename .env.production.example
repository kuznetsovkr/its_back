# Runtime
NODE_ENV=production
PORT=5000
PUBLIC_APP_URL=https://example.com
# Exact browser origins, comma-separated. Wildcards and URL paths are not supported.
ALLOWED_PUBLIC_ORIGINS=https://example.com,https://www.example.com
FRONTEND_BUILD_DIR=../its_prototype/build
UPLOAD_DIR=./uploads

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=replace_with_database_name
DB_USER=replace_with_database_user
DB_PASSWORD=replace_with_rotated_database_password

# Admin authentication and guest order access
# Generate independent random values for each secret below.
JWT_SECRET=replace_with_random_secret_at_least_32_bytes
ORDER_ACCESS_SECRET=replace_with_a_different_random_secret_at_least_32_bytes
ORDER_ACCESS_TOKEN_TTL_HOURS=24
ADMIN_PHONE=replace_with_admin_phone
ADMIN_PASSWORD=replace_with_strong_unique_password

# Cloudflare Turnstile protects public order creation. The site key is public
# and is returned to the frontend by /api/public-config; keep the secret only here.
TURNSTILE_ENABLED=1
TURNSTILE_SITE_KEY=replace_with_real_turnstile_site_key
TURNSTILE_SECRET_KEY=replace_with_real_turnstile_secret_key
TURNSTILE_EXPECTED_HOSTNAMES=example.com,www.example.com

# CDEK
CDEK_BASE_URL=https://api.cdek.ru/v2
CDEK_CLIENT_ID=replace_with_rotated_client_id
CDEK_CLIENT_SECRET=replace_with_rotated_client_secret
CDEK_CHECKOUT_TARIFF_CODE=136
CDEK_FROM_CITY_CODE=278
CDEK_FROM_COUNTRY_CODE=RU
CDEK_FROM_POSTAL_CODE=660135
ENABLE_CDEK_RETRY_CRON=1

# Inventory reservation is created with the draft order and released after TTL
# if payment was not completed.
ORDER_RESERVATION_TTL_MINUTES=30
ENABLE_RESERVATION_CRON=1

# PayKeeper
PAYKEEPER_BASE_URL=https://replace-with-paykeeper-host
PAYKEEPER_LOGIN=replace_with_rotated_login
PAYKEEPER_PASSWORD=replace_with_rotated_password
PAYKEEPER_SECRET_SEED=replace_with_rotated_secret_seed

# Telegram: independent channels with independent bots and recipient lists.
# Chat IDs are comma-separated; *_CHAT_IDS are permanent destinations and are
# automatically included in the matching allowlist.
# Alternatively, leave the ID lists empty and share a private Telegram deep link
# containing the matching random invite token (32-64 URL-safe characters).
# Optional dedicated HTTP/HTTPS CONNECT proxy used only for Telegram traffic.
# Keep credentials in the separate variables instead of committing them in the URL.
TELEGRAM_PROXY_URL=
TELEGRAM_PROXY_USERNAME=
TELEGRAM_PROXY_PASSWORD=
ENABLE_TELEGRAM_ORDER_CHANNEL=0
ENABLE_TELEGRAM_LOW_STOCK_CHANNEL=0
ENABLE_LOW_STOCK_CRON=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_ORDER_INVITE_TOKEN=
TELEGRAM_ORDER_CHAT_IDS=
TELEGRAM_ORDER_ALLOWED_CHAT_IDS=
TELEGRAM_LOW_BOT_TOKEN=
TELEGRAM_LOW_STOCK_INVITE_TOKEN=
TELEGRAM_LOW_STOCK_CHAT_IDS=
TELEGRAM_LOW_STOCK_ALLOWED_CHAT_IDS=
LOW_STOCK_THRESHOLD=5

# Operations. Active order photos and inventory catalog images are never
# deleted by the retention job. A dedicated monitoring bot is optional; when
# omitted, the orders bot and its active subscribers receive infrastructure alerts.
ITS_MONITOR_URL=https://example.com
ITS_MONITOR_DISK_WARNING_PERCENT=80
ITS_MONITOR_DISK_CRITICAL_PERCENT=90
ITS_MONITOR_BACKUP_MAX_AGE_HOURS=30
ITS_MONITOR_TELEGRAM_BOT_TOKEN=
ITS_MONITOR_TELEGRAM_CHAT_IDS=
# Optional dead-man's-switch ping supplied by an external uptime service.
ITS_MONITOR_HEARTBEAT_URL=
ITS_RELEASES_TO_KEEP=5
ORDER_UPLOAD_SENT_RETENTION_DAYS=180
ORDER_UPLOAD_CANCELLED_RETENTION_DAYS=30
ORDER_UPLOAD_ORPHAN_RETENTION_DAYS=7
ORDER_UPLOAD_TEMP_RETENTION_HOURS=24
ORDER_UPLOAD_CLEANUP_DRY_RUN=0

# Database and startup diagnostics. Run `npm run db:migrate` before each release.
ENABLE_SQL_LOGGING=0
ENABLE_STARTUP_WARNINGS=1
TRUST_PROXY=1

# Shared rate-limit storage. Use rediss:// when Redis is outside a trusted private network.
RATE_LIMIT_STORE=redis
REDIS_URL=redis://default:replace_with_redis_password@127.0.0.1:6379/0
RATE_LIMIT_REDIS_PREFIX=its:production:rate-limit
REDIS_CONNECT_TIMEOUT_MS=5000
