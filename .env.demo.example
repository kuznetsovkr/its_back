# HTTP
PORT=5000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=its_database
DB_USER=postgres
DB_PASSWORD=postgres

# Admin auth and guest order access (set your own values)
JWT_SECRET=replace_with_random_secret
ORDER_ACCESS_SECRET=replace_with_a_different_random_secret
ORDER_ACCESS_TOKEN_TTL_HOURS=24
ADMIN_PHONE=+79990000000
ADMIN_PASSWORD=replace_with_strong_password

# Public URL used in payment and callback links
PUBLIC_APP_URL=http://localhost:5000

# Files
UPLOAD_DIR=./uploads

# Demo toggles (recommended for temporary demo)
ENABLE_TELEGRAM_BOTS=0
ENABLE_LOW_STOCK_CRON=0
ENABLE_SQL_LOGGING=0
ENABLE_DB_ALTER_SYNC=0
ENABLE_STARTUP_WARNINGS=0

# CDEK credentials (either *_CLIENT_* or *_ACCOUNT/*_PASSWORD)
CDEK_BASE_URL=https://api.cdek.ru/v2
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
# CDEK_ACCOUNT=
# CDEK_PASSWORD=
# Optional token for protected create_order calls to /service.php
# If empty, backend falls back to JWT_SECRET
CDEK_SERVICE_TOKEN=

# Optional explicit local endpoint for order->CDEK handoff
CDEK_SERVICE_URL=http://localhost:5000/service.php

# Optional external integrations (fill only if needed)
PAYKEEPER_BASE_URL=
PAYKEEPER_LOGIN=
PAYKEEPER_PASSWORD=
PAYKEEPER_SECRET_SEED=
